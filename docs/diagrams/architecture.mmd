---
title: DND Game Architecture (after phase 7)
---
flowchart TD
    subgraph ENTRY["Entry points / tools"]
        RUN["run.sh / test.sh"]
        MAIN["game/main.py<br/>pygame init, sprites, music, menu loop<br/>headless / auto / connect / host-game flags"]
        MEDIT["map_editor.py<br/>tile map editor (validates on save)"]
        SRVCLI["python -m game.net.server<br/>standalone host"]
    end

    subgraph CLIENT["Client (pygame)"]
        MENUS["menus.py<br/>character / map select<br/>Enter = solo, H = host, J = join"]
        SESS["session.py<br/>input -> commands, render from view,<br/>HUD, quest panel, TTS, saves"]
        VIEW["client/view.py  ClientView<br/>mirror of snapshots, interpolation"]
        LOCAL["client/local_host.py<br/>LocalHost (solo, in-process)"]
        REMOTE["net/client.py<br/>RemoteHost (TCP)"]
    end

    subgraph NET["Network (no pygame)"]
        SERVER["net/server.py  HostServer<br/>authoritative 30 Hz tick, up to 4 players,<br/>127.0.0.1 only, flow control"]
        PROTO["net/protocol.py<br/>JSON lines, v2 handshake"]
        DELTA["net/delta.py<br/>entity deltas"]
    end

    subgraph SIM["Simulation (pure Python)  game/engine"]
        WORLD["world.py  World<br/>step(): commands, players, companions,<br/>monsters, kills/XP, respawns, projectiles"]
        PLAYER["player.py  PlayerState<br/>per player: hero, quests, casting,<br/>movement, autopilot"]
        CMDS["commands.py<br/>MoveTo, Cast, SelectTarget, ..."]
        EVENTS["events.py<br/>FloatText, LevelUp, NpcDialogue, ..."]
        SNAP["snapshot.py<br/>per-player snapshot"]
        BOOT["bootstrap.py<br/>create_world / join_player"]
        REPLAY["replay.py<br/>command-log replay"]
        CORE["entities, ai, hero_ai, abilities,<br/>npc, pathfinding"]
        WMAP["world_map.py + map_schema.py<br/>validated maps, content hash"]
    end

    subgraph CONTENT["Content and rules"]
        RULES["content/heroes, content/monsters,<br/>progression, quests, saves, headless"]
    end

    subgraph DATA["Data on disk"]
        MAPS[("data/maps")]
        QJSON[("data/quests")]
        SAVEF[("data/saves")]
        ASSETS[("assets/")]
        GOLDEN[("tests/golden, tests/replays")]
    end

    RUN --> MAIN
    MAIN --> MENUS
    MAIN -->|"runpy per session"| SESS
    SESS --> VIEW
    SESS -->|"solo"| LOCAL
    SESS -->|"co-op"| REMOTE
    SESS -->|"H = host: background thread"| SERVER
    SRVCLI --> SERVER
    LOCAL -->|"submit / step"| WORLD
    LOCAL -->|"snapshot + events"| SNAP
    REMOTE <-->|"TCP 127.0.0.1"| SERVER
    REMOTE --> PROTO
    SERVER --> PROTO
    SERVER --> DELTA
    REMOTE --> DELTA
    SERVER -->|"submit / step"| WORLD
    SERVER --> SNAP
    SERVER --> BOOT
    LOCAL -.-> BOOT

    WORLD --> PLAYER
    WORLD --> CMDS
    WORLD --> EVENTS
    WORLD --> CORE
    WORLD --> WMAP
    PLAYER --> CORE
    SNAP --> WORLD
    REPLAY --> BOOT
    BOOT --> RULES
    WORLD --> RULES

    WMAP --> MAPS
    RULES --> QJSON
    RULES --> SAVEF
    MEDIT --> MAPS
    MEDIT --> WMAP
    MAIN --> ASSETS
    REPLAY -.->|"regression tests"| GOLDEN

    classDef entry fill:#ffd699,stroke:#cc7a00,color:#000
    classDef sim fill:#99ccff,stroke:#0066cc,color:#000
    classDef net fill:#e1bee7,stroke:#6a1b9a,color:#000
    classDef content fill:#c8e6c9,stroke:#2e7d32,color:#000
    classDef data fill:#eeeeee,stroke:#666,color:#000
    classDef client fill:#ff9999,stroke:#cc0000,color:#000
    class RUN,MAIN,MEDIT,SRVCLI entry
    class MENUS,SESS,VIEW,LOCAL,REMOTE client
    class SERVER,PROTO,DELTA net
    class WORLD,PLAYER,CMDS,EVENTS,SNAP,BOOT,REPLAY,CORE,WMAP sim
    class RULES content
    class MAPS,QJSON,SAVEF,ASSETS,GOLDEN data
